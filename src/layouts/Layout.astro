---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Head from '../components/Head.astro';
import SocialHeader from '../components/SocialHeader.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { themes, DEFAULT_THEME } from '../data/themes';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  withBack?: boolean;
}

const { title, description, ogType, withBack = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js" data-theme={DEFAULT_THEME.id} data-scheme={DEFAULT_THEME.scheme}>
  <head>
    <Head title={title} description={description} ogType={ogType} />
    <script is:inline define:vars={{ themes, defaultId: DEFAULT_THEME.id }}>
      // Runs synchronously before first paint: apply the saved theme and flag
      // that JS is available (the html.js class gates scroll-reveal hiding).
      (function () {
        var id = defaultId;
        try {
          var saved = localStorage.getItem('theme');
          if (
            saved &&
            themes.some(function (t) {
              return t.id === saved;
            })
          ) {
            id = saved;
          }
        } catch (e) {
          /* locked-down storage: keep the default theme */
        }
        var entry = themes.filter(function (t) {
          return t.id === id;
        })[0];
        var root = document.documentElement;
        root.setAttribute('data-theme', entry.id);
        root.setAttribute('data-scheme', entry.scheme);
        root.classList.remove('no-js');
        root.classList.add('js');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', entry.bg);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* Phoenix mark — icon #8161382, The Noun Project, purchased royalty-free
        license (2026-07-25). Not covered by the repo's MIT grant. Used by the
        ambient layer and the footer glyph below. */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="phoenix-mark" viewBox="0 0 1200 1200">
        <path d="m557.76 339.84s-38.812 24.703-38.812 79.453 31.266 75.703 10.031 91.359c-21.281 15.656-48.938-20.859-66-52.547-29.156-54.188-79.734-73.406-110.11-132.05-25.453-49.078-48.328-115.69-11.25-207.19-83.531 60.609-104.44 134.39-42.891 225.66-57.938-49.547-67.5-99-70.359-130.97-42.422 90.234-1.0781 174.14 60.609 208.82-42.188-8.1562-75.609-34.688-104.86-69.891-0.375 47.344 22.312 135.19 134.48 150.84-41.156 6.2344-82.266-3.9375-123.42-21.234 20.062 41.625 59.812 100.41 169.45 86.25-21.844 15.703-61.922 20.953-108.38 22.547 60.562 49.734 116.95 45.656 171.66 19.031-20.109 22.641-45.844 41.156-83.625 50.859 49.547 17.438 98.016 19.594 142.87-27.422-4.4062 19.406-13.922 37.219-30.094 53.109 28.922 0.46875 57.938 1.9688 82.266-38.953 13.594 82.922-18.797 111.56-55.734 133.18-103.97 60.703-93.516 126.84-63.281 162.37-1.4531-51.797 26.625-90.141 72.094-116.81-82.734 98.109-9.7031 188.02 46.453 195.1-39.516-43.641-38.438-84.609-33.188-118.12 2.6719 115.17 135.94 87.938 134.95 177.84 34.5-50.484-1.3125-98.625-51.328-132.71-50.297-34.312-54.75-120.94-6.6562-161.48 0 0-40.406 68.719 15.469 126.1 29.156 29.906 59.859 20.531 84.938 70.359 2.9531-76.547-54.891-56.297-84.516-129.61 33.938 53.297 84.609 39.844 105.28 20.344-63.984 5.3906-94.172-87.469-65.906-123.42 27.281-34.734 42.047-72.562 42.047-72.562 22.125 12.188 44.25 9.9844 66.375 8.3906-33.938-21.75-32.953-39.609-36.281-57.938 55.266 59.438 118.5 45.516 142.45 33.188-30.656-11.344-58.547-27-80.953-51.328 58.641 28.547 116.11 30.797 171.19-19.453-35.906 0-71.766 0.70312-108.84-23.438 74.25 11.156 134.81-10.078 172.55-84.938-46.922 21.234-86.203 24.656-122.53 21.234 99.141-20.766 129.79-82.453 131.86-152.63-26.391 32.812-58.5 59.531-104.86 71.25 106.5-69.891 78.234-166.97 60.609-208.36-3.6094 55.734-40.266 105.19-70.359 129.61 68.625-98.062 23.953-181.87-42.469-224.29 47.531 112.41 1.0312 212.53-67.688 276.52-26.156 24.328-42.891 31.406-69.469 84.938-12.047 24.281-42.469 37.594-42.469 37.594 0.09375-11.953-7.125-23.625-40.266-50.859-75.047-61.734 31.219-134.53 78.75-103.08-3.1406-19.219-15.281-42.984-59.719-36.281 0 0-5.2969-32.297-81.422-16.828-48.094 9.7969-63.281-16.359-63.281-16.359s-3.0938 37.969 44.484 44.859z"/>
      </symbol>
    </svg>

    <div class="cursor" aria-hidden="true"></div>
    <div class="cursor-follower" aria-hidden="true"></div>

    <div class="bg-shapes" aria-hidden="true">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>

    <div class="ambient-phoenix" aria-hidden="true">
      <svg><use href="#phoenix-mark"></use></svg>
    </div>

    <SocialHeader withBack={withBack} />

    <main id="main" class="container">
      <slot />
    </main>

    {/* No data-animate here: the reveal observer excludes the bottom 10% of
        the viewport, and a footer lives there permanently — it would never
        reveal. Footers don't need an entrance anyway. */}
    <footer class="site-footer">
      <p>
        <svg class="footer-mark" aria-hidden="true"><use href="#phoenix-mark"></use></svg>
        © {new Date().getFullYear()} Simona Oancea ·
        <a href="https://github.com/simonaOancea/simonaoancea.com" target="_blank" rel="noopener">
          MIT-licensed source
        </a>
      </p>
    </footer>

    <ThemePicker />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
